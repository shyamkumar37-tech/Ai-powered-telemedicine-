type PatientType {
    id: ID!
    fullName: String
    email: String
    active: Boolean
}

type HealthRecordType {
    id: ID!
    bloodPressure: String
    sugar: Float
    spo2: Float
    pulse: Float
    temperature: Float
    recordedAt: String
}

type Query {
    patientProfile(id: ID!): PatientType
    patientHealthRecords(patientId: ID!): [HealthRecordType]
}
