SERVER_PORT=8080
# For local mvnw runs, omit TELECARE_DB_URL to use localhost.
# For Docker Compose, omit TELECARE_DB_URL to use the compose service host.
# Set this only when you need a custom database URL.
TELECARE_DB_URL=
TELECARE_DB_USERNAME=postgres
TELECARE_DB_PASSWORD=change-me-local-db-password
TELECARE_JPA_DDL_AUTO=update
TELECARE_SHOW_SQL=false

TELECARE_JWT_SECRET=change-me-at-least-32-random-characters
TELECARE_JWT_EXPIRATION_MS=86400000
TELECARE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

TELECARE_OTP_DEMO_MODE=true
TELECARE_OTP_TTL_SECONDS=300
TELECARE_OTP_SENDER_LABEL=TeleCare+

TELECARE_AI_ENABLED=false
TELECARE_AI_PROVIDER=local
TELECARE_AI_API_BASE_URL=http://localhost:11434
TELECARE_AI_API_KEY=
TELECARE_AI_MODEL=
TELECARE_AI_TIMEOUT_SECONDS=20
TELECARE_AI_TEMPERATURE=0.2

TELECARE_SMS_ENABLED=false
TELECARE_SMS_MODE=mock
TELECARE_SMS_PROVIDER=twilio
TELECARE_SMS_FROM=TeleCare+
TELECARE_SMS_ACCOUNT_SID=
TELECARE_SMS_AUTH_TOKEN=
TELECARE_SMS_API_BASE_URL=https://api.twilio.com
TELECARE_SMS_MESSAGING_SERVICE_SID=

TELECARE_EMAIL_ENABLED=false
TELECARE_EMAIL_MODE=live
TELECARE_EMAIL_PROVIDER=smtp
TELECARE_EMAIL_FROM=no-reply@telecareplus.local
TELECARE_SMTP_HOST=
TELECARE_SMTP_PORT=587
TELECARE_SMTP_USERNAME=
TELECARE_SMTP_PASSWORD=
TELECARE_SMTP_AUTH=true
TELECARE_SMTP_STARTTLS=true

TELECARE_WHATSAPP_ENABLED=false
TELECARE_WHATSAPP_MODE=live
TELECARE_WHATSAPP_PROVIDER=twilio
TELECARE_WHATSAPP_FROM=whatsapp:+14155238886
TELECARE_WHATSAPP_ACCOUNT_SID=
TELECARE_WHATSAPP_AUTH_TOKEN=
TELECARE_WHATSAPP_API_BASE_URL=https://api.twilio.com
TELECARE_WHATSAPP_MESSAGING_SERVICE_SID=

TELECARE_PUSH_ENABLED=true
TELECARE_PUSH_MODE=webpush
TELECARE_PUSH_PROVIDER=browser
TELECARE_PUSH_FROM=TeleCare+
TELECARE_PUSH_SUBJECT=mailto:alerts@telecareplus.local
TELECARE_PUSH_PUBLIC_KEY=generate-a-new-vapid-public-key
TELECARE_PUSH_PRIVATE_KEY=generate-a-new-vapid-private-key

TELECARE_TWILIO_ACCOUNT_SID=
TELECARE_TWILIO_AUTH_TOKEN=

VITE_API_BASE_URL=http://localhost:8080/api
